# Copy to .env (ignored). Use a NEW hostname, ports and device identity on another machine.
DASHSCOPE_API_KEY=replace-with-your-own-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Set a workspace endpoint here when required by your model entitlement.
DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference/
COMPANION_DEVICE_ID=02:00:00:00:00:01
COMPANION_SUBJECT_SCOPE=example-person-01
PUBLIC_WS_URL=ws://your-server.example:18000/xiaozhi/v1/
PUBLIC_HTTP_URL=http://your-server.example:18003
BIND_ADDRESS=127.0.0.1
VOICE_WS_PORT=18000
VOICE_HTTP_PORT=18003
BROWSER_PORT=18006
MANAGER_PORT=18002
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
MINIAPP_AUTH_ENABLED=false
MINIAPP_WECHAT_APP_ID=
MINIAPP_WECHAT_SECRET=
MINIAPP_SESSION_TTL_SECONDS=604800
